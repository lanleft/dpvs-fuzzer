// TODO: modify this to support more packet types
static struct rte_mbuf* create_mbuf_from_proto(const dpvs::Mbuf& proto) {
    struct rte_mbuf *mbuf;
    uint8_t *data;
    uint8_t eth_header_size = 14;
    uint8_t ip_header_size = 20;
    uint8_t transport_header_size = 20;
    uint32_t payload_size = proto.has_payload() ? proto.payload().size() : 0;

    mbuf = rte_pktmbuf_alloc(pktmbuf_pool[0]);
    if (!mbuf) {
        return NULL;
    }

    mbuf_userdata_reset(mbuf);

    mbuf->port = 0;
    mbuf->nb_segs = 1;
    mbuf->ol_flags = 0;
    mbuf->packet_type = proto.packet_type();

    data = rte_pktmbuf_mtod(mbuf, uint8_t *);  // void *buf_addr -> buffer pointer

    // Ethernet header
    if (proto.eth_header_size() > 0) {
        if (!serialize_eth_header(proto.eth_header(0), data)) {
            printf("[ERR] Failed to serialize Ethernet header\n");
            return NULL;
        }
    } else {
        printf("[ERR] No Ethernet header\n");
        return NULL;
    }
    data += eth_header_size;

    // VLAN tag // optional 
    if (proto.has_vlan_tci()) {
        mbuf->vlan_tci = proto.vlan_tci();
        mbuf->ol_flags |= RTE_MBUF_F_RX_VLAN_STRIPPED;
    }

    // IP header
    if (proto.ip_header_size() > 0) {
        if (!serialize_ip_header(proto.ip_header(0), data)) {
            printf("[ERR] Failed to serialize IP header\n");
            return NULL;
        }
    } else {
        printf("[ERR] No IP header\n");
        return NULL;
    }
    data += ip_header_size;

    // Transport header
    if (proto.transport_header_size() > 0) {
        if (!serialize_tcp_header(proto.transport_header(0), data)) {
            printf("[ERR] Failed to serialize TCP header\n");
            return NULL;
        }
    } else {
        printf("[ERR] No transport header\n");
        return NULL;
    }
    data += transport_header_size;

    // Payload -> optional
    if (proto.has_payload()) {
        if (proto.payload().size() > 0) {
            memcpy(data, proto.payload().data(), proto.payload().size());
        }
    }

    mbuf->pkt_len = eth_header_size + ip_header_size + transport_header_size + payload_size;
    mbuf->data_len = mbuf->pkt_len; // data len 
    mbuf->data_off = 128; // data offset 

    // printf("[INFO] create proto mbuf: %p\n", mbuf);
    return mbuf;
}

#if defined(LLVM_BATCH_TEST)

void print_buffer(const char *buffer, int length) {
    for (int i = 0; i < length; i++) {
        printf("%c", (unsigned char)buffer[i]);
    }
    printf("\n");
}

int main(int argc, char **argv) {
    static bool initialized = false;
    struct rte_mbuf *mbuf;
    int err;
    dpvs::Mbuf proto;
    
    printf("Begining normal main\n");
    if (!initialized) {
        if (init_dpdk() < 0) {
            return 1;
        }

        initialized = true;
    }

    /* batch test */

    if (getenv("FUZZ_BATCH_TEST")) {
        printf("\033[1;33mBatch test\033[0m\n");
        char *list_file = getenv("FUZZ_BATCH_TEST");
        if (!list_file) {
            printf("No list file provided\n");
            return 1;
        }
        FILE *fp = fopen(list_file, "r");
        if (!fp) {
            printf("Failed to open list file: %s\n", list_file);
            return 1;
        }
        char line[1024];
        while (fgets(line, sizeof(line), fp)) {
            line[strcspn(line, "\n")] = '\0';
            printf("Processing file: %s\n", line);

            // open fd
            int fd = open(line, O_RDONLY);
            if (fd < 0) {
                printf("Failed to open file: %s\n", line);
                return 1;
            }

            // Parse the buffer as a binary protobuf
            // ParseTextMessage
            if (proto.ParseFromFileDescriptor(fd)) {
                printf("\033[1;33mCreating mbuf from protobuf message\033[0m\n");
                mbuf = create_mbuf_from_proto(proto);
                if (!mbuf) {
                    printf("\033[1;31mFailed to create mbuf from protobuf message\033[0m\n");
                    continue;
                }
                printf("\033[1;32mCalling netif_rcv_mbuf\033[0m\n");
                netif_rcv_mbuf(dev_port, rte_lcore_id(), mbuf, false);
                rte_pktmbuf_free(mbuf);
            } else {
                printf("\033[1;31mFailed to parse protobuf message\033[0m\n");
            }
        }
        fclose(fp);
        return 0;
    }

    return 0;
}

#else 

// Main fuzzer function
DEFINE_PROTO_FUZZER(const dpvs::Mbuf& proto) {
    static bool initialized = false;
    static struct rte_mbuf *mbuf = NULL;
    
    printf("Begining fuzzing\n");
    if (!initialized) {
        if (init_dpdk() < 0) {
            return;
        }

        initialized = true;
    }
    // yellow color
    printf("\033[1;33mCreating mbuf from protobuf message\033[0m\n");
    // Create mbuf from protobuf message
    mbuf = create_mbuf_from_proto(proto);
    if (!mbuf) {
        return;
    }
    
    // print with green color, and bold
    printf("\033[1;32mCalling netif_rcv_mbuf\033[0m\n");
    // printf("[INFO] mbuf: %p\n", mbuf);
    // Call the target function
    netif_rcv_mbuf(dev_port, rte_lcore_id(), mbuf, false);

    // Cleanup
    printf("Freeing mbuf\n");
    rte_pktmbuf_free(mbuf);
}

#endif // LLVM_FUZZER

