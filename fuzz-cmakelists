cmake_minimum_required(VERSION 3.13)

# Find required packages
find_package(Protobuf REQUIRED)
find_package(Threads REQUIRED)

# include(protobuf)
# include(googletest)
include_directories(${PROJECT_SOURCE_DIR})


# Set fuzzing flags
set(FUZZING_FLAGS "-fsanitize=fuzzer,address -fno-omit-frame-pointer -g -O1")
set(FUZZING_FLAGS_BINARY "-fsanitize=fuzzer,address")

# DPVS configuration
add_definitions(-DDPVS_MAX_LCORE=4 -DDPVS_MAX_SOCKET=2)

# DPDK paths
set(DPDK_PATH "/home/lab/Desktop/side-projects/linux-setup/dpvs-fuzzer/dpdk-24.11")
set(DPDK_LIB_PATH "${DPDK_PATH}/dpdklib")
set(DPDK_BUILD_PATH "${DPDK_PATH}/dpdkbuild")
set(DPVS_PATH "/home/lab/Desktop/side-projects/linux-setup/dpvs-fuzzer/dpvs")
set(PROTOBUF_MUTATOR_PATH "/home/lab/Desktop/side-projects/linux-setup/dpvs-fuzzer/libprotobuf-mutator/")

# DPDK compiler flags
set(DPDK_CFLAGS "-include rte_config.h -march=native -mrtm -I${DPDK_LIB_PATH}/include")

# DPDK libraries
set(DPDK_LIBS
    -L${DPDK_LIB_PATH}/lib/x86_64-linux-gnu
    -Wl,--as-needed
    -lrte_node -lrte_graph -lrte_pipeline -lrte_table -lrte_pdump
    -lrte_port -lrte_fib -lrte_pdcp -lrte_ipsec -lrte_vhost -lrte_stack
    -lrte_security -lrte_sched -lrte_reorder -lrte_rib -lrte_mldev
    -lrte_regexdev -lrte_rawdev -lrte_power -lrte_pcapng -lrte_member
    -lrte_lpm -lrte_latencystats -lrte_jobstats -lrte_ip_frag -lrte_gso
    -lrte_gro -lrte_gpudev -lrte_dispatcher -lrte_eventdev -lrte_efd
    -lrte_dmadev -lrte_distributor -lrte_cryptodev -lrte_compressdev
    -lrte_cfgfile -lrte_bpf -lrte_bitratestats -lrte_bbdev -lrte_acl
    -lrte_timer -lrte_hash -lrte_metrics -lrte_cmdline -lrte_pci
    -lrte_ethdev -lrte_meter -lrte_net -lrte_mbuf -lrte_mempool
    -lrte_rcu -lrte_ring -lrte_eal -lrte_telemetry -lrte_argparse
    -lrte_kvargs -lrte_log
)

# =====================================================================
# Generate protobuf files
protobuf_generate_cpp(MBUF_PROTO_SRCS MBUF_PROTO_HDRS mbuf_mutator.proto)

# Create a library for the protobuf files
add_library(mbuf-mutator-proto
            ${MBUF_PROTO_SRCS})

add_library(protobuf-mutator-libfuzzer
            ${PROTOBUF_MUTATOR_PATH}/src/libfuzzer/libfuzzer_mutator.cc
            ${PROTOBUF_MUTATOR_PATH}/src/libfuzzer/libfuzzer_macro.cc)


set_property(TARGET mbuf-mutator-proto
             PROPERTY COMPILE_FLAGS ${FUZZING_FLAGS})

# Add the fuzzer executable
add_executable(dpvs-fuzzer dpvs-fuzzer.cc)
target_link_libraries(dpvs-fuzzer
                      protobuf-mutator-libfuzzer
                      mbuf-mutator-proto
                      ${Protobuf_LIBRARIES}
                      ${CMAKE_THREAD_LIBS_INIT}
                      ${DPDK_LIBS})

# Set fuzzing flags for the executable
set_property(TARGET dpvs-fuzzer
             PROPERTY COMPILE_FLAGS "${FUZZING_FLAGS} ${DPDK_CFLAGS}")
set_property(TARGET dpvs-fuzzer
             PROPERTY LINK_FLAGS ${FUZZING_FLAGS_BINARY})

# Add include directories
target_include_directories(dpvs-fuzzer PRIVATE
                          ${Protobuf_INCLUDE_DIRS}
                          ${DPVS_PATH}/include
                          ${DPDK_LIB_PATH}/include
                          ${PROTOBUF_MUTATOR_PATH}
                          ${CMAKE_CURRENT_SOURCE_DIR}/include/fakes
                          ${CMAKE_CURRENT_SOURCE_DIR}
                          ${PROJECT_SOURCE_DIR}) 


